DATABASE_URL=postgresql://sports:sports@db:5432/sports

# Telegram (leave empty to stay local). Signals are only sent when SIGNALS_DRY_RUN=false.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
SIGNALS_DRY_RUN=true
SIGNAL_LANG=tr

# Live odds (https://the-odds-api.com), format key=League,key2=League2
ODDS_API_KEY=
ODDS_API_SPORTS=soccer_epl=Premier League
ODDS_API_REGIONS=eu

# Protects POST /admin/train-bayes/run; empty disables the endpoint
ADMIN_TOKEN=

# Signal filters
MIN_EDGE=0.03
UNCERTAINTY_K=1.0
MAX_EDGE=0.25
MIN_ODDS=1.30
MAX_ODDS=6.00
